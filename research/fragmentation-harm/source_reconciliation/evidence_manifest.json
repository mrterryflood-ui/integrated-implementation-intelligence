  "findings": [
    {
      "id": "F1",
      "status": "documented_common_category_specification",
      "claim": "2019-2023 falls wholly within Summary Stage 2018. NPCR Merged uses direct item764; SEER Combined uses derived item762 by published default. Both codebooks map1 localized,2/3/4 regional,7 distant,9 unknown. Different wrapper names alone are not evidence of incompatible stage constructs.",
      "sources": [
        "cdc_uscs_2001_2023_technical.pdf",
        "seer_nov2025_description.pdf",
        "naaccr_v25_item762.html",
        "naaccr_v25_item764.html"
      ]
    },
    {
      "id": "F2",
      "status": "documented_registry_year_exception",
      "claim": "SEER Nov2025 transmission requirements permit Texas item762 and EOD772/774/776 only when available for2018-2021. This neither proves absence nor proves a fallback executed. No explicit public Texas2019-2021 direct-to-derived fallback was recovered in the inspected documentation.",
      "sources": [
        "seer_nov2025_required_dataitems.pdf"
      ]
    },
    {
      "id": "F3",
      "status": "original_execution_not_recovered",
      "claim": "The retained SCP footnotes permit alternative staging variables as necessary and identify late as regional or distant. They do not expose selected alternative variables or per-case derivation, the exact historical algorithm build, or an explicit accounting of unknown/blank/invalid/DCO/autopsy denominator membership.",
      "sources": [
        "retained source exports"
      ]
    },
    {
      "id": "F4",
      "status": "selection_specification_documented",
      "claim": "SCP FAQ links the ICD-O-3/WHO2008 site recode; Colon and Rectum comprises C180-C189,C199,C209,C260 with histology exclusions9050-9055,9140,9590-9993. Malignant ICD-O-3 behavior3 is the invasive incidence cohort; appendix is included, anus is not.",
      "sources": [
        "scp_faq.html",
        "scp_malignant.html",
        "seer_site_recode_icdo3_who2008.html"
      ]
    },
    {
      "id": "F5",
      "status": "uniform_cdc_specification_documented",
      "claim": "CDC public-use definitions classify both Mississippi and Texas asNPCR, using direct SS2018#764 for2018+. CDC stage visualization excludes DCO/autopsy-only and explicitly offers unknown-inclusive and known-stage-only denominators. These rules are valid for a newly specified CDC analysis, not proof of the old SCP execution.",
      "sources": [
        "cdc_uscs_2001_2023_technical.pdf",
        "cdc_stage_at_diagnosis.html",
        "cdc_dataviz_2023_technical.pdf"
      ]
    },
    {
      "id": "F6",
      "status": "official_public_access_limit",
      "claim": "USCS2001-2023 technical documentation p66 explicitly says county-level records are not available in the public-use database under state data-sharing agreements; they are held in restricted-accessRDC. This is not a claim that all aggregate county statistics are unavailable. The public county all-stage file recovered by another agent contains no stage field; stage input availability must not be fabricated.",
      "sources": [
        "cdc_uscs_2001_2023_technical.pdf"
      ]
    },
    {
      "id": "F7",
      "status": "documented_manual_inconsistency_not_data_error",
      "claim": "Mississippi2021 SS2018 allowable-values header includes5, while its own code table omits5 and NAACCRv25 disallows5. This supports correcting the manual, not an assertion that any retained Hinds record used5.",
      "sources": [
        "mississippi_reporting_2021.html",
        "naaccr_v25_item764.html"
      ]
    },
    {
      "id": "F8",
      "status": "historical_negative_control_not_retrieved",
      "claim": "The earlier official search-index record for the September2024 Texas CRC brief describes a stage chart excluding unknown and including in situ; raw PDF retrieval now returns404. Preserve as a qualified prior lead, not as recovered bytes. The currently linked July2026 brief is a different document. The fully archived CDC note independently demonstrates why published stage percentages can use different denominators.",
      "sources": [
        "texas_crc_2024_brief.pdf",
        "texas_crc_2024_brief_www.pdf",
        "cdc_stage_at_diagnosis.html"
      ]
    }
  ],
